# Copy to .env (never commit .env). Docker Compose and the backend read these.
POSTGRES_DB=clothing_platform
POSTGRES_USER=clothing
POSTGRES_PASSWORD=change_me_locally

DB_URL=jdbc:postgresql://localhost:5432/clothing_platform
DB_USERNAME=clothing
DB_PASSWORD=change_me_locally
REDIS_HOST=localhost
REDIS_PORT=6379

# Generate with: openssl rand -base64 48
JWT_SECRET=
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Bootstrap Super Admin (consumed once by Phase 2 bootstrap runner)
BOOTSTRAP_SUPERADMIN_EMAIL=
BOOTSTRAP_SUPERADMIN_PASSWORD=

# Razorpay (Phase 8) - test keys during development
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# SMTP / SMS / Maps / Storage (later phases)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMS_PROVIDER_API_KEY=
GOOGLE_MAPS_API_KEY=
STORAGE_BUCKET=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
