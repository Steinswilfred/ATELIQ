# Copy to .env (never commit .env)
DB_URL=jdbc:postgresql://localhost:5432/clothing_platform
DB_USERNAME=clothing
DB_PASSWORD=change-me
REDIS_HOST=localhost
REDIS_PORT=6379
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=14
CORS_ALLOWED_ORIGINS=http://localhost:5173
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=
# Razorpay (test keys in dev; secret stays on the backend only)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# SMS provider, maps, cloud storage: added in the phases that use them
FRONTEND_URL=http://localhost:5173
COOKIE_SECURE=false
SMS_PROVIDER=log
STORAGE_LOCAL_DIR=./data/uploads
